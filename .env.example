# Copy to .env, fill in, then: chmod 600 .env   (never commit .env)
SECRET_KEY=change-me-to-a-long-random-string

# Development: DEBUG=True.  Production: DEBUG=False, which also turns on
# secure cookies, the HTTPS redirect, HSTS and hashed static file names.
DEBUG=True

# Production: ALLOWED_HOSTS=sr.iskcongorakhpur.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: CSRF_TRUSTED_ORIGINS=https://sr.iskcongorakhpur.com
CSRF_TRUSTED_ORIGINS=

# postgres://ROLE:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://sadhna_user:password@127.0.0.1:5432/sadhna_db

# Optional. HSTS lifetime in seconds when DEBUG=False (default 30 days).
# SECURE_HSTS_SECONDS=2592000
